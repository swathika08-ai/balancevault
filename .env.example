# Copy to backend/.env (never commit the real file)
DATABASE_URL=postgresql://balancevault:balancevault@localhost:5432/balancevault
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# Leave empty to disable the HTTP bootstrap endpoint entirely
BOOTSTRAP_TOKEN=
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
RUN_MIGRATIONS=true
PORT=4000
